{
    "exclude": ["node_modules", "src", "styles"],
    "compilerOptions": {
        "target": "ES2015",
        "lib": ["ES2017", "DOM"],
        "module": "ES2015",
        "moduleResolution": "node",
        "rootDirs": ["./public/typescript", "./public/interfaces"],
        "outDir": "./public/js",
        "esModuleInterop": true,
        "strict": true
    }
}